#!/bin/bash
COLORS_FILE="$HOME/.local/state/quickshell/user/generated/colors.json"
r=255; g=255; b=255
get_color() {
  hex=$(jq -r ".primary" "$COLORS_FILE" 2>/dev/null | cut -c2-)
  if [[ ${#hex} -eq 6 ]]; then
    r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
  fi
}
python3 -u "$HOME/.local/bin/lyriz-local-first.py" | python3 -u "$HOME/.local/bin/lyriz-romanize.py" | while IFS= read -r line; do
  get_color
  clear
  printf "\033[38;2;%s;%s;%sm" "$r" "$g" "$b"
  figlet -f small -w "$(tput cols)" "$line"
  printf "\033[0m"
done
