#!/bin/bash
COLORS_FILE=~/.local/state/quickshell/user/generated/colors.json
r=255; g=255; b=255

# NOTE: This color file is NOT universal. It is generated by an
# illogical-impulse (quickshell + matugen) setup. On other machines it
# usually won't exist, and the text will simply stay white (255,255,255).
# To use another theme tool, change the path below and the '.primary' key
# in get_color().

get_color() {
  hex=$(jq -r '.primary' "$COLORS_FILE" 2>/dev/null | cut -c2-)
  if [[ ${#hex} -eq 6 ]]; then
    r=$((16#${hex:0:2}))
    g=$((16#${hex:2:2}))
    b=$((16#${hex:4:2}))
  fi
}

romanize() {
  local text="$1"
  if echo "$text" | grep -qP '[\x{3040}-\x{30FF}\x{4E00}-\x{9FFF}]'; then
    echo "$text" | kakasi -Ja -Ha -Ka -Ea -ra -s
  elif echo "$text" | grep -qP '[\x{0980}-\x{09FF}]'; then
    python3 ~/.local/bin/bangla_romanize.py "$text"
  else
    echo "$text"
  fi
}

sptlrx pipe | while read -r line; do
  get_color
  romanized=$(romanize "$line")
  clear
  printf '\033[38;2;%s;%s;%sm' "$r" "$g" "$b"
  figlet -f small -w "$(tput cols)" "$romanized"
  printf '\033[0m'
done
