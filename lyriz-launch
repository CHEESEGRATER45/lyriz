printf '#!/bin/bash
COLORS_FILE=~/.local/state/quickshell/user/generated/colors.json
r=255; g=255; b=255

get_color() {
  hex=$(jq -r ".primary" "$COLORS_FILE" 2>/dev/null | cut -c2-)
  if [[ ${#hex} -eq 6 ]]; then
    r=$((16#${hex:0:2}))
    g=$((16#${hex:2:2}))
    b=$((16#${hex:4:2}))
  fi
}

romanize() {
  local text="$1"
  if echo "$text" | grep -qP "[\x{3040}-\x{30FF}\x{4E00}-\x{9FFF}]"; then
    echo "$text" | kakasi -Ja -Ha -Ka -Ea -ra -s
  elif echo "$text" | grep -qP "[\x{0980}-\x{09FF}]"; then
    python3 -c "
from indic_transliteration import sanscript
import sys, unicodedata
out = sanscript.transliterate(sys.argv[1], sanscript.BENGALI, sanscript.ITRANS)
out = unicodedata.normalize(\"NFKD\", out).encode(\"ascii\", \"ignore\").decode(\"ascii\")
print(out)
" "$text"
  else
    echo "$text"
  fi
}

sptlrx pipe | while read -r line; do
  get_color
  romanized=$(romanize "$line")
  clear
  printf "\\033[38;2;%s;%s;%sm" "$r" "$g" "$b"
  figlet -f small "$romanized"
  printf "\\033[0m"
done
' > ~/.local/bin/lyriz-launch-inner
chmod +x ~/.local/bin/lyriz-launch-inner